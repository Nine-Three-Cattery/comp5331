  "html": "\n            \n\n\n\n\n<div id=\"course_home_content\">\n    <div id=\"wiki_page_show\"><div class=\"header-bar-outer-container\">\n  <div class=\"sticky-toolbar\" data-sticky=\"\">\n    <div class=\"header-bar page-toolbar as-course-home\">\n      <div class=\"page-toolbar-start\">\n        <div class=\"page-heading\">\n              <h1 class=\"course-title\" title=\"COMP5331 (L1) - Knowledge Discovery in Databases\">COMP5331 (L1) - Knowledge Discovery in Databases<button aria-haspopup=\"dialog\" class=\"ally-accessible-versions ally-add-tooltip\" data-id=\"page:708679\" data-ally-content-id=\"page:708679\" data-ally-richcontent-eid=\"page:708679\" aria-label=\"Alternative formats\" title=\"Alternative formats\">\n    <svg width=\"22\" height=\"13\" viewBox=\"0 0 22 13\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\" focusable=\"false\" role=\"presentation\">\n        <path fill=\"currentColor\" d=\"M22,4.3875 L17.1875,11.7 L12.375,4.3875 L15.2625,4.3875 L15.2625,0 L19.1125,0 L19.1125,4.3875 L22,4.3875 Z M0,13 L7.56170223,2.6 L15.125,13 L11.5074634,13 C10.8377941,11.637446 9.34323244,10.6886103 7.60683311,10.6886103 C5.87043379,10.6886103 4.37564424,11.637446 3.70597488,13 L0,13 Z M5.76079766,8.21256906 C5.76079766,9.12421192 6.56722727,9.86326321 7.56170223,9.86326321 C8.55617719,9.86326321 9.36237887,9.12421192 9.36237887,8.21256906 C9.36237887,7.3009262 8.55617719,6.56187491 7.56170223,6.56187491 C6.56722727,6.56187491 5.76079766,7.3009262 5.76079766,8.21256906 Z\"></path>\n    </svg>\n</button></h1>\n        </div>\n        </div>\n        <div class=\"page-toolbar-end\">\n          <div class=\"buttons\">\n\n          </div>\n        </div>\n      </div>\n    </div>\n    <div class=\"page-changed-alert\" role=\"alert\" aria-atomic=\"true\" aria-live=\"polite\"></div>\n  </div>\n\n<div id=\"direct-share-mount-point\"></div>\n\n<div class=\"show-content user_content clearfix enhanced\" data-resource-type=\"wiki_page.body\" d